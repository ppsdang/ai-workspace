{
  "extraKnownMarketplaces": {
    "ai-workspace": {
      "source": {
        "source": "github",
        "repo": "{{PLUGIN_REPO}}"
      }
    }
  },
  "enabledPlugins": {
    "ai-workspace@ai-workspace": true
  },
  "permissions": {
    "allow": [
      "Bash(git -C * status*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * log*)",
      "Bash(git -C * show*)",
      "Bash(git -C * fetch*)",
      "Bash(git -C * rev-parse*)",
      "Bash(git -C * branch --show-current)",
      "Bash(python3 *kb.py*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git -C * clean -f*)",
      "Bash(gh pr merge*)",
      "Bash(glab mr merge*)",
      "Bash(gh repo delete*)",
      "Bash(glab repo delete*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  }
}
