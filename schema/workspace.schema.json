{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppsdang/ai-workspace/schema/workspace.schema.json",
  "title": "ai-workspace manifest (workspace.yaml)",
  "type": "object",
  "required": [
    "version",
    "codebases"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "multi",
        "single"
      ],
      "default": "multi",
      "description": "multi: codebases cloned into codebase/<name>. single: this repository is the only codebase."
    },
    "worktrees": {
      "type": "boolean",
      "default": false,
      "description": "Give each task its own checkout under work/<KEY>/<name> so tasks can run in parallel."
    },
    "tools": {
      "type": "array",
      "items": {
        "enum": [
          "claude-code",
          "cursor"
        ]
      },
      "uniqueItems": true,
      "default": [
        "claude-code"
      ],
      "description": "AI tools the team uses; decides which instruction and rule files init writes"
    },
    "workspace": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tracker": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "jira",
            "github",
            "trello",
            "markdown",
            "custom",
            "none"
          ]
        },
        "via": {
          "enum": [
            "mcp",
            "api",
            "command"
          ]
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "jira: site URL"
        },
        "project": {
          "type": "string",
          "description": "jira: project key"
        },
        "acceptance_field": {
          "type": "string",
          "description": "jira: custom field with acceptance criteria, e.g. customfield_10042"
        },
        "repo": {
          "type": "string",
          "pattern": "^[\\w.-]+/[\\w.-]+$",
          "description": "github: owner/repo"
        },
        "path": {
          "type": "string",
          "description": "markdown: folder with task files, relative to the workspace root"
        },
        "mcp_server": {
          "type": "string",
          "description": "custom via mcp: connected MCP server name"
        },
        "commands": {
          "type": "object",
          "description": "custom via command: templates with {key} and {status}. Without commands or mcp_server, a custom tracker is 'not connected yet' and tasks are described by hand",
          "properties": {
            "fetch": {
              "type": "string"
            },
            "comment": {
              "type": "string"
            },
            "transition": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "statuses": {
          "type": "object",
          "description": "Tracker statuses used at plan approval (start) and after MRs open (review).",
          "properties": {
            "start": {
              "type": "string"
            },
            "review": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "jira"
              }
            }
          },
          "then": {
            "required": [
              "base_url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "github"
              }
            }
          },
          "then": {
            "required": [
              "repo"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "markdown"
              }
            }
          },
          "then": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "git_host": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "github",
            "gitlab",
            "other",
            "none"
          ],
          "description": "github (incl. Enterprise) | gitlab (incl. self-hosted; MRs via glab or git push options) | other (push + link to open the PR) | none (local only, nothing is pushed)"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Web URL for self-hosted GitLab, GitHub Enterprise or other hosts, e.g. https://gitlab.example.com"
        },
        "default_branch": {
          "type": "string",
          "default": "main"
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "sync": {
          "enum": [
            "rebase",
            "merge"
          ],
          "default": "rebase"
        }
      },
      "additionalProperties": false
    },
    "codebases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "url": {
            "type": "string",
            "description": "clone URL, or a local folder (multi mode)"
          },
          "path": {
            "type": "string",
            "description": "single mode only: \".\""
          },
          "branch": {
            "type": "string",
            "description": "base branch, overrides git_host.default_branch"
          },
          "tdd": {
            "enum": [
              "strict",
              "when-tests-exist",
              "off"
            ],
            "default": "when-tests-exist"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "dir"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "dir": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*\\.\\.)"
                },
                "ci_job": {
                  "type": "string",
                  "description": "jenkins: job path for this component, e.g. platform/api"
                }
              },
              "additionalProperties": false
            }
          },
          "ci_job": {
            "type": "string",
            "description": "jenkins: job path, e.g. payroll/backend; \"none\" = no job of its own (only shared jobs build it)"
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "path"
            ]
          }
        ]
      },
      "description": "The repositories. May be empty while setting up; add them later and re-run init."
    },
    "branching": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "default": "{type}/{key}-{slug}"
        }
      },
      "additionalProperties": false
    },
    "protected_branches": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "main",
        "master",
        "develop",
        "release/*"
      ]
    },
    "gates": {
      "type": "object",
      "properties": {
        "quick_fix": {
          "enum": [
            "end",
            "both"
          ],
          "default": "end"
        }
      },
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "host",
            "jenkins",
            "custom",
            "none"
          ],
          "default": "host",
          "description": "host: GitHub Actions / GitLab CI; jenkins; custom (your script); none"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "jenkins: server URL"
        },
        "job_pattern": {
          "type": "string",
          "description": "jenkins: job path pattern for codebases, e.g. {group}/{repo}. Placeholders: {group} {owner} {repo} {codebase}. ci_job overrides it."
        },
        "component_job_pattern": {
          "type": "string",
          "description": "jenkins: job path pattern for monorepo components, e.g. {repo}/{component}. Adds {component}."
        },
        "shared_jobs": {
          "type": "array",
          "description": "jenkins: jobs that check out several repositories (integration, end-to-end)",
          "items": {
            "type": "object",
            "required": [
              "job",
              "codebases"
            ],
            "additionalProperties": false,
            "properties": {
              "job": {
                "type": "string",
                "description": "job path, e.g. payroll/integration"
              },
              "codebases": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "description": "codebases this job checks out"
              },
              "parameters": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "for re-runs: parameter templates; {branch} = task branch, {branch:<codebase>} = task branch if that codebase changed, else its base branch"
              }
            }
          }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "description": "custom: templates with {codebase} {branch} {sha} {build}. Without commands, custom CI is 'not connected yet'",
          "properties": {
            "status": {
              "type": "string"
            },
            "log": {
              "type": "string"
            },
            "rerun": {
              "type": "string"
            }
          }
        },
        "max_rounds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "jenkins"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "url"
            ]
          }
        }
      ]
    },
    "guard": {
      "type": "object",
      "properties": {
        "confirm_outward": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
